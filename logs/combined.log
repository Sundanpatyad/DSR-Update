{"level":"info","message":"\n=== Changes for src/services/webhookService.js (Added) by sundan.shrama@psquarecompany.com ===","service":"git-commit-tracker","timestamp":"2026-03-25T06:35:31.710Z"}
{"level":"info","message":"Additions: 34 | Deletions: 0","service":"git-commit-tracker","timestamp":"2026-03-25T06:35:31.710Z"}
{"level":"info","message":"Patch:","service":"git-commit-tracker","timestamp":"2026-03-25T06:35:31.710Z"}
{"level":"info","message":"@@ -0,0 +1,34 @@\n+/**\n+ * Service to handle and process commit message tags,\n+ * specifically extracting Problem Statements for reporting.\n+ */\n+\n+const extractProblemStatement = commitMessage => {\n+  const match = commitMessage.match(/\\[Problem Statement: (.*?)\\]/);\n+  return match ? match[1].trim() : null;\n+};\n+\n+const webhookService = {\n+  /**\n+   * Processes an incoming commit message to identify and extract\n+   * the Problem Statement tag.\n+   *\n+   * @param {string} commitMessage - The raw commit message.\n+   * @returns {string | null} The extracted problem statement.\n+   */\n+  processCommitMessage: commitMessage => {\n+    console.log(`Processing commit message: ${commitMessage}`);\n+    const problemStatement = extractProblemStatement(commitMessage);\n+\n+    if (problemStatement) {\n+      console.log(`✅ Extracted Problem Statement: ${problemStatement}`);\n+      // In a real backend, you'd send this to your monthly repository Excel file.\n+      return problemStatement;\n+    } else {\n+      console.log('❌ No Problem Statement tag found in message.');\n+      return null;\n+    }\n+  },\n+};\n+\n+module.exports = webhookService;","service":"git-commit-tracker","timestamp":"2026-03-25T06:35:31.710Z"}
