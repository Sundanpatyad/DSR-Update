{"level":"info","message":"@@ -0,0 +1,89 @@\n+import { color } from '@styles/color';\n+import { font } from '@styles/typography';\n+import { truncate } from '@utils/truncate';\n+import React, { memo } from 'react';\n+import { Pressable, StyleSheet, Text, View } from 'react-native';\n+\n+const TaskChip = memo(({ item, activeChip, onSelect }: any) => (\n+  <Pressable\n+    style={[styles.chip, activeChip === item.task_id && styles.chipSelected]}\n+    onPress={() => onSelect(item.task_id)}\n+  >\n+    <Text\n+      style={[\n+        styles.chipText,\n+        activeChip === item.task_id && styles.chipTextSelected,\n+      ]}\n+    >\n+      {truncate(item.taskName, 15)}\n+    </Text>\n+    <View\n+      style={[\n+        styles.badge,\n+        activeChip === item.task_id && styles.badgeSelected,\n+      ]}\n+    >\n+      <Text\n+        style={[\n+          styles.badgeText,\n+          activeChip === item.task_id && styles.badgeTextSelected,\n+        ]}\n+      >\n+        {item.count}\n+      </Text>\n+    </View>\n+  </Pressable>\n+));\n+\n+const styles = StyleSheet.create({\n+  chip: {\n+    flexDirection: 'row',\n+    alignItems: 'center',\n+    paddingVertical: 8,\n+    paddingHorizontal: 14,\n+    borderRadius: 20,\n+    backgroundColor: color.white,\n+    marginHorizontal: 6,\n+    elevation: 4,\n+    shadowColor: color.black,\n+    shadowOffset: { width: 0, height: 2 },\n+    shadowOpacity: 0.1,\n+    shadowRadius: 3,\n+  },\n+  chipSelected: {\n+    backgroundColor: '#fff',\n+    borderWidth: 1.5,\n+    borderColor: '#007680',\n+  },\n+  chipText: {\n+    fontSize: 14,\n+    fontFamily: font.NunitoMedium,\n+    color: color.black60,\n+    marginRight: 6,\n+  },\n+  chipTextSelected: {\n+    color: color.primary,\n+    fontWeight: '600',\n+  },\n+  badge: {\n+    minWidth: 20,\n+    height: 20,\n+    borderRadius: 10,\n+    backgroundColor: color.primaryLow,\n+    justifyContent: 'center',\n+    alignItems: 'center',\n+    paddingHorizontal: 5,\n+  },\n+  badgeSelected: {\n+    backgroundColor: '#007680',\n+  },\n+  badgeText: {\n+    fontSize: 12,\n+    color: '#444',\n+  },\n+  badgeTextSelected: {\n+    color: color.white,\n+  },\n+});\n+\n+export default TaskChip;","service":"git-commit-tracker","timestamp":"2026-03-25T07:41:49.144Z"}
