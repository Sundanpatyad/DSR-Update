{"level":"info","message":"@@ -0,0 +1,110 @@\n+import BottomModal from '@components/common/BottomModal';\n+import React from 'react';\n+import { FlatList, StyleSheet, Text, View } from 'react-native';\n+import {\n+  responsiveScreenHeight,\n+  responsiveScreenWidth,\n+} from 'react-native-responsive-dimensions';\n+import SubtaskListItem from './SubtaskListItem';\n+import TaskChip from './TaskChip';\n+\n+type Props = {\n+  visible: boolean;\n+  onClose: () => void;\n+\n+  taskChips: any[];\n+  subtasks: any[];\n+\n+  activeChip: string;\n+  selectedOption: any;\n+\n+  onChipSelect: (id: string) => void;\n+  onSubtaskSelect: (item: any) => void;\n+\n+  title?: string;\n+  height?: number;\n+};\n+\n+const SubtaskSelectorModal: React.FC<Props> = ({\n+  visible,\n+  onClose,\n+  taskChips,\n+  subtasks,\n+  activeChip,\n+  selectedOption,\n+  onChipSelect,\n+  onSubtaskSelect,\n+  title = 'Subtasks',\n+  height = 50,\n+}) => {\n+  const filteredSubtasks = subtasks.filter(\n+    (st: any) => st.task_id === activeChip,\n+  );\n+\n+  return (\n+    <BottomModal visible={visible} onClose={onClose} fixedHeight={height}>\n+      <View style={styles.container}>\n+        <Text style={styles.heading}>{title}</Text>\n+\n+        <View style={styles.chipsContainer}>\n+          <FlatList\n+            data={taskChips}\n+            horizontal\n+            showsHorizontalScrollIndicator={false}\n+            keyExtractor={item => item.task_id}\n+            contentContainerStyle={styles.chipsContentContainer}\n+            renderItem={({ item }) => (\n+              <TaskChip\n+                item={item}\n+                activeChip={activeChip}\n+                onSelect={onChipSelect}\n+              />\n+            )}\n+          />\n+        </View>\n+\n+        <FlatList\n+          data={filteredSubtasks}\n+          keyExtractor={item => item._id}\n+          showsVerticalScrollIndicator={false}\n+          renderItem={({ item }) => (\n+            <SubtaskListItem\n+              item={item}\n+              isSelected={selectedOption?._id === item._id}\n+              onSelect={onSubtaskSelect}\n+            />\n+          )}\n+        />\n+      </View>\n+    </BottomModal>\n+  );\n+};\n+\n+export default SubtaskSelectorModal;\n+\n+const styles = StyleSheet.create({\n+  container: {\n+    height: '100%',\n+    paddingTop: responsiveScreenHeight(3),\n+    paddingBottom: responsiveScreenHeight(1),\n+    paddingHorizontal: responsiveScreenWidth(4),\n+    borderTopLeftRadius: 20,\n+    borderTopRightRadius: 20,\n+    backgroundColor: '#fff',\n+  },\n+  heading: {\n+    fontSize: 20,\n+    fontWeight: '600',\n+    textAlign: 'center',\n+    marginBottom: 20,\n+    color: '#000',\n+  },\n+  chipsContainer: {\n+    marginBottom: 15,\n+  },\n+  chipsContentContainer: {\n+    paddingHorizontal: 10,\n+    flexDirection: 'row',\n+    justifyContent: 'center',\n+  },\n+});","service":"git-commit-tracker","timestamp":"2026-03-25T07:41:49.144Z"}
