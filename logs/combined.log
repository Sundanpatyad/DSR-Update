{"level":"info","message":"\n=== Changes for git-commit.js (Added) by sundan.shrama@psquarecompany.com ===","service":"git-commit-tracker","timestamp":"2026-03-25T06:35:31.709Z"}
{"level":"info","message":"Additions: 63 | Deletions: 0","service":"git-commit-tracker","timestamp":"2026-03-25T06:35:31.710Z"}
{"level":"info","message":"Patch:","service":"git-commit-tracker","timestamp":"2026-03-25T06:35:31.710Z"}
{"level":"info","message":"@@ -0,0 +1,63 @@\n+const { execSync } = require('child_process');\n+const readline = require('readline');\n+\n+const rl = readline.createInterface({\n+  input: process.stdin,\n+  output: process.stdout,\n+});\n+\n+const askQuestion = query =>\n+  new Promise(resolve => rl.question(query, resolve));\n+\n+async function runCommit() {\n+  console.log('\\n--- Custom Git Commit Setup ---\\n');\n+\n+  try {\n+    // 1. Prompts for Message\n+    const commitMessage = await askQuestion('1. Enter your commit message: ');\n+    if (!commitMessage) {\n+      console.log('Commit message is required. Aborting.');\n+      rl.close();\n+      return;\n+    }\n+\n+    // 2. Prompts for Problem Statement\n+    const problemStatement = await askQuestion(\n+      '2. Enter the Problem Statement / Ticket Issue: ',\n+    );\n+    if (!problemStatement) {\n+      console.log('Problem Statement is required. Aborting.');\n+      rl.close();\n+      return;\n+    }\n+\n+    // 3. Auto-Formatting\n+    const finalMessage = `${commitMessage} [Problem Statement: ${problemStatement}]`;\n+    console.log(`\\nFormatted message: \"${finalMessage}\"`);\n+\n+    // 4. Git Operations\n+    console.log('\\nRunning: git add .');\n+    execSync('git add .');\n+\n+    console.log(`Running: git commit -m \"${finalMessage}\"`);\n+    execSync(`git commit -m \"${finalMessage}\"`);\n+\n+    // 5. Instant Push\n+    const pushChoice = await askQuestion(\n+      '\\n3. Do you want to push now? (y/n): ',\n+    );\n+    if (pushChoice.toLowerCase() === 'y') {\n+      console.log('Running: git push');\n+      execSync('git push');\n+      console.log('\\n✅ Changes pushed successfully!');\n+    } else {\n+      console.log('\\nCommit complete. Push skipped.');\n+    }\n+  } catch (error) {\n+    console.error('\\n❌ Error during git operations:', error.message);\n+  } finally {\n+    rl.close();\n+  }\n+}\n+\n+runCommit();","service":"git-commit-tracker","timestamp":"2026-03-25T06:35:31.710Z"}
